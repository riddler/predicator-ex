# The directory Mix will write compiled artifacts to.
/_build

# If you run "mix test --cover", coverage assets end up here.
/cover

# The directory Mix downloads your dependencies sources to.
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Dialyzer PLT files
/priv/plts/

/config/

src/*.erl

.claude/*.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Local beads telemetry churn; the tracker syncs via refs/dolt/data.
.beads/interactions.jsonl
