[
  {
    "id": "functions/len",
    "source": "len(\"hello\")",
    "expected": { "result": 5 }
  },
  {
    "id": "functions/upper",
    "source": "upper(\"world\")",
    "expected": { "result": "WORLD" }
  },
  {
    "id": "functions/starts-with",
    "source": "starts_with(\"hello world\", \"hello\")",
    "expected": { "result": true }
  },
  {
    "id": "functions/substring-three-arg",
    "source": "substring(\"hello world\", 0, 5)",
    "expected": { "result": "hello" },
    "notes": "substring's arity is [2, 3] - both forms are accepted"
  },
  {
    "id": "functions/index-of-not-found",
    "source": "index_of(\"hello world\", \"nope\")",
    "expected": { "result": -1 }
  },
  {
    "id": "functions/concat-lists",
    "source": "concat([1, 2], [3])",
    "expected": { "result": [1, 2, 3] }
  },
  {
    "id": "functions/math-pow",
    "source": "Math.pow(2, 3)",
    "expected": { "result": 8 },
    "notes": "integer base and non-negative integer exponent return an integer, computed exactly; a float argument or a negative exponent returns a float"
  },
  {
    "id": "functions/math-pow-float-arg",
    "source": "Math.pow(2.0, 3)",
    "expected": { "result": 8.0 }
  },
  {
    "id": "functions/math-pow-negative-exponent",
    "source": "Math.pow(2, -1)",
    "expected": { "result": 0.5 }
  },
  {
    "id": "functions/math-max",
    "source": "Math.max(2, 3)",
    "expected": { "result": 3 }
  },
  {
    "id": "functions/date-year",
    "source": "Date.year(#2024-03-15#)",
    "expected": { "result": 2024 }
  },
  {
    "id": "functions/unknown-function",
    "source": "nope(1)",
    "expected": {
      "error": { "type": "EvaluationError", "reason": "Unknown function: nope" }
    },
    "notes": "docs/isa.md: an unknown function name is an EvaluationError with operation function_call; the builtin function set itself is not part of the ISA - see the Language Reference"
  },
  {
    "id": "functions/insufficient-arguments-on-stack",
    "instructions": [["call", "len", 1]],
    "expected": {
      "error": { "type": "EvaluationError", "reason": "insufficient_arguments" }
    },
    "notes": "fewer than arg_count values on the stack - only reachable from a hand-built instruction list, since the compiler always emits enough operand instructions to match the call's arg_count"
  },
  {
    "id": "functions/ends-with",
    "source": "ends_with(\"hello world\", \"world\")",
    "expected": { "result": true }
  },
  {
    "id": "functions/lower",
    "source": "lower(\"WORLD\")",
    "expected": { "result": "world" }
  },
  {
    "id": "functions/trim",
    "source": "trim(\"  hello  \")",
    "expected": { "result": "hello" },
    "notes": "trims leading and trailing whitespace only; the corpus does not pin internal whitespace, which trim() leaves untouched"
  },
  {
    "id": "functions/math-abs",
    "source": "Math.abs(-7)",
    "expected": { "result": 7 }
  },
  {
    "id": "functions/math-sqrt",
    "source": "Math.sqrt(16)",
    "expected": { "result": 4 },
    "notes": "a non-negative integer with an exact integer root returns an integer; every other numeric argument returns a float"
  },
  {
    "id": "functions/math-sqrt-inexact",
    "source": "Math.sqrt(2)",
    "expected": { "result": 1.4142135623730951 }
  },
  {
    "id": "functions/math-sqrt-negative-error",
    "source": "Math.sqrt(-1)",
    "expected": {
      "error": {
        "type": "EvaluationError",
        "reason": "Math.sqrt expects a non-negative number"
      }
    },
    "notes": "Math.sqrt of a negative number is an EvaluationError (operation function_call), not NaN and not a complex result - a sibling implementer should not assume IEEE-754 NaN propagation here. reason equals message for this class of error; see functions/json-parse-invalid-error's note."
  },
  {
    "id": "functions/math-ceil",
    "source": "Math.ceil(2.1)",
    "expected": { "result": 3 },
    "notes": "returns an integer, not a float"
  },
  {
    "id": "functions/math-floor",
    "source": "Math.floor(2.9)",
    "expected": { "result": 2 },
    "notes": "returns an integer, not a float"
  },
  {
    "id": "functions/math-min",
    "source": "Math.min(3, 7)",
    "expected": { "result": 3 }
  },
  {
    "id": "functions/math-round-half-away-from-zero",
    "source": "Math.round(-2.5)",
    "expected": { "result": -3 },
    "notes": "rounds half away from zero: -2.5 rounds to -3, not -2 (banker's rounding) and not toward positive infinity"
  },
  {
    "id": "functions/json-stringify-map-keys-sorted",
    "source": "JSON.stringify(user)",
    "context": { "user": { "name": "John", "age": 30 } },
    "expected": { "result": "{\"age\":30,\"name\":\"John\"}" },
    "notes": "JSON.stringify sorts map keys alphabetically in its output - predicator maps have no defined iteration order, so a sibling should sort keys too rather than assume insertion order round-trips"
  },
  {
    "id": "functions/json-parse-array",
    "source": "JSON.parse(\"[1,2,3]\")",
    "expected": { "result": [1, 2, 3] }
  },
  {
    "id": "functions/json-parse-invalid-error",
    "source": "JSON.parse(\"not json\")",
    "expected": {
      "error": {
        "type": "EvaluationError",
        "reason": "Invalid JSON: unexpected byte 0x6F at position 1"
      }
    },
    "notes": "reason equals message for this error, unlike most opcode-level errors - JSON.parse's failure path does not carry a separate structured token, only the human-readable description"
  },
  {
    "id": "functions/date-month",
    "source": "Date.month(#2024-03-15#)",
    "expected": { "result": 3 }
  },
  {
    "id": "functions/date-day",
    "source": "Date.day(#2024-03-15#)",
    "expected": { "result": 15 }
  }
]
