  {
    "id": "membership/intersects-mixed-types-miss",
    "source": "[1, \"a\"] intersects [\"1\", true]",
    "expected": {
      "result": false
    },
    "notes": "equality is type-matched, with no coercion"
  },
  {
    "id": "membership/intersects-mixed-types-hit",
    "source": "[1, \"a\"] intersects [true, \"a\"]",
    "expected": {
      "result": true
    }
  },
  {
    "id": "membership/intersects-dates",
    "source": "[#2026-03-01#, #2026-04-01#] intersects due",
    "context": {
      "due": [
        {
          "$type": "date",
          "value": "2026-04-01"
        }
      ]
    },
    "expected": {
      "result": true
    }
  },
  {
    "id": "membership/intersects-date-datetime-same-instant",
    "source": "[#2026-03-01#] intersects due",
    "context": {
      "due": [
        {
          "$type": "datetime",
          "value": "2026-03-01T00:00:00Z"
        }
      ]
    },
    "expected": {
      "result": true
    },
    "notes": "a date and a datetime compare by instant"
  },
