      "result": true
    }
  },
  {
    "id": "membership/contains-case-sensitive",
    "source": "title contains \"moby\"",
    "context": {
      "title": "Moby Dick"
    },
    "expected": {
      "result": false
    },
    "notes": "the substring test is case-sensitive"
  },
  {
