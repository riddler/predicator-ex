  },
  {
    "id": "membership/contains-no-normalization",
    "source": "word contains \"i\"",
    "context": {
      "word": "naïve"
    },
    "expected": {
      "result": false
    },
    "notes": "U+00EF is one code point, not i followed by a combining mark"
  },
