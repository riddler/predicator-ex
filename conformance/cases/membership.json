      }
    },
    "notes": "a string container with a non-string needle answers undefined; replaces membership/contains-left-must-be-list"
  },
  {
    "id": "membership/contains-substring-hit",
    "source": "title contains \"Moby\"",
    "context": {
      "title": "Moby Dick"
    },
    "expected": {
      "result": true
    }
  },
  {
    "id": "membership/contains-substring-miss",
