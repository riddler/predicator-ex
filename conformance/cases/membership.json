  {
    "id": "membership/intersects-hit",
    "source": "loan.tags intersects [\"poetry\", \"drama\"]",
    "context": {
      "loan": {
        "tags": [
          "fiction",
          "poetry"
        ]
      }
    },
    "expected": {
      "result": true
    }
  },
  {
    "id": "membership/intersects-miss",
    "source": "loan.tags intersects [\"history\", \"drama\"]",
    "context": {
      "loan": {
        "tags": [
          "fiction",
          "poetry"
        ]
      }
    },
    "expected": {
      "result": false
    }
  },
  {
    "id": "membership/intersects-upper-case",
    "source": "loan.tags INTERSECTS [\"poetry\"]",
    "context": {
      "loan": {
        "tags": [
          "fiction",
          "poetry"
        ]
      }
    },
    "expected": {
      "result": true
    }
  },
