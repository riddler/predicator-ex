[
  {
    "id": "durations/single-unit",
    "source": "3d",
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 0,
          "days": 3,
          "hours": 0,
          "minutes": 0,
          "seconds": 0
        }
      }
    },
    "notes": "hand-decode: the duration value has eight keys, all present, defaulting to 0 - this is the normative shape from docs/isa.md section 3. The JSON omits a zero milliseconds as a compaction rule of the codec; see conformance/README.md"
  },
  {
    "id": "durations/multi-unit",
    "source": "2w3d",
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 2,
          "days": 3,
          "hours": 0,
          "minutes": 0,
          "seconds": 0
        }
      }
    }
  },
  {
    "id": "durations/milliseconds-key-present-only-when-used",
    "source": "500ms",
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 0,
          "days": 0,
          "hours": 0,
          "minutes": 0,
          "seconds": 0,
          "milliseconds": 500
        }
      }
    },
    "notes": "a ms-family unit gives a non-zero milliseconds, which is the only condition under which the tagged encoding writes the key out; the duration value itself always carries all eight units (px-69c). The case id predates that fix and is kept because shipped corpus ids are stable (conformance/RATCHET.md)"
  },
  {
    "id": "durations/later-unit-pair-overwrites-earlier",
    "instructions": [["duration", [[1, "h"], [2, "h"]]]],
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 0,
          "days": 0,
          "hours": 2,
          "minutes": 0,
          "seconds": 0
        }
      }
    },
    "notes": "docs/isa.md: later pairs overwrite earlier ones naming the same unit - reachable from source too (e.g. an author writing 1h2h), but a hand-built list states the intent directly"
  },
  {
    "id": "durations/invalid-unit",
    "instructions": [["duration", [[3, "xyz"]]]],
    "expected": {
      "error": { "type": "EvaluationError", "reason": "invalid_duration_unit" }
    },
    "notes": "only reachable from a hand-built instruction list - the lexer/parser never produce an unrecognized unit string, which is why this case authors instructions directly rather than source"
  },
  {
    "id": "durations/invalid-format",
    "instructions": [["duration", [["bad"]]]],
    "expected": {
      "error": { "type": "EvaluationError", "reason": "invalid_duration_format" }
    },
    "notes": "a unit pair that is not [integer, string] - also only reachable via a hand-built instruction list"
  },
  {
    "id": "durations/datetime-plus-duration",
    "source": "#2024-01-15T10:00:00Z# + 2h",
    "expected": {
      "result": { "$type": "datetime", "value": "2024-01-15T12:00:00Z" }
    }
  },
  {
    "id": "durations/date-minus-duration",
    "source": "#2024-01-15# - 3d",
    "expected": {
      "result": { "$type": "date", "value": "2024-01-12" }
    }
  },
  {
    "id": "durations/fractional-literal-expands",
    "source": "1.5s",
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 0,
          "days": 0,
          "hours": 0,
          "minutes": 0,
          "seconds": 1,
          "milliseconds": 500
        }
      }
    },
    "notes": "the fraction expands at parse time to integer unit pairs, so the duration opcode's operand shape is unchanged; this case is what pins the expansion for a sibling"
  },
  {
    "id": "durations/fractional-month-uses-approximation",
    "source": "0.5mo",
    "expected": {
      "result": {
        "$type": "duration",
        "value": {
          "years": 0,
          "months": 0,
          "weeks": 0,
          "days": 15,
          "hours": 0,
          "minutes": 0,
          "seconds": 0
        }
      }
    },
    "notes": "a fractional mo commits this project's documented 30-day approximation at parse time, which is why the exported value has no months component"
  }
]
