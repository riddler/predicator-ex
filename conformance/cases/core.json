[
  {
    "id": "core/literal-integer",
    "source": "42",
    "expected": { "result": 42 },
    "notes": "the simplest possible tier-1 case: a bare literal, no context"
  },
  {
    "id": "core/literal-true",
    "source": "true",
    "expected": { "result": true }
  },
  {
    "id": "comparison/gt-int-true",
    "source": "score > 85",
    "context": { "score": 90 },
    "expected": { "result": true }
  },
  {
    "id": "comparison/gt-int-false",
    "source": "score > 85",
    "context": { "score": 80 },
    "expected": { "result": false },
    "notes": "boundary is exclusive; see comparison/gt-int-boundary"
  },
  {
    "id": "comparison/gt-int-boundary",
    "source": "score > 85",
    "context": { "score": 85 },
    "expected": { "result": false },
    "notes": "85 is not > 85 - the boundary is exclusive"
  },
  {
    "id": "comparison/loose-eq-int-float",
    "source": "1 == 1.0",
    "expected": { "result": true },
    "notes": "docs/isa.md: loose equality compares by numeric value across int/float"
  },
  {
    "id": "comparison/strict-eq-int-float-false",
    "source": "1 === 1.0",
    "expected": { "result": false },
    "notes": "docs/isa.md: strict equality also requires matching type, unlike =="
  },
  {
    "id": "logical/and-short-circuit-false",
    "source": "false and true",
    "expected": { "result": false }
  },
  {
    "id": "logical/or-short-circuit-true",
    "source": "true or false",
    "expected": { "result": true }
  },
  {
    "id": "logical/not-true",
    "source": "not true",
    "expected": { "result": false }
  },
  {
    "id": "logical/unary-minus",
    "source": "-score",
    "context": { "score": 5 },
    "expected": { "result": -5 }
  },
  {
    "id": "logical/unary-bang",
    "source": "true == !false",
    "expected": { "result": true },
    "notes": "! at a non-top-level unary position compiles to unary_bang; NOT/top-level ! compile to the not opcode instead (see legacy.json for the bare and/or opcodes and short_circuit.json for the jump opcodes)"
  },
  {
    "id": "core/literal-undefined",
    "source": "undefined",
    "expected": { "result": { "$type": "undefined" } },
    "notes": "the undefined literal (px-ocp): a source spelling for a lit operand the ISA's value domain already admitted (docs/isa.md section 3), so no ISA version moves - surface syntax is outside the ISA (section 6)"
  },
  {
    "id": "core/undefined-strict-eq-undefined",
    "source": "undefined === undefined",
    "expected": { "result": true }
  },
  {
    "id": "core/undefined-strict-ne-int",
    "source": "undefined !== 1",
    "expected": { "result": true }
  },
  {
    "id": "core/undefined-eq-propagates",
    "source": "undefined == undefined",
    "expected": { "result": { "$type": "undefined" } },
    "notes": "the non-strict operators propagate :undefined rather than answering (docs/reference/language.md, reject vs. propagate) - === is the boundness test, == is not"
  }
]
